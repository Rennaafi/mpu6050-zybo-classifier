#pragma once

// Copy this file to "secrets.h" and set the WiFi network name/password the
// ESP32 will broadcast as its own access point (not a network it joins).
// secrets.h is gitignored so your real values never get committed.
//
// AP password must be 8+ characters (WPA2 minimum), or "" for an open network.

#define SECRET_WIFI_SSID     "esp32-dashboard"
#define SECRET_WIFI_PASSWORD "changeme123"
